{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "experimentalDecorators": true, // required for typegoose
    "emitDecoratorMetadata": true, // required for typegoose
    "outDir": "dist",
    "baseUrl": "./src",
    "skipLibCheck": true
  },
  "include": ["src"]
}
