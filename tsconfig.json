{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@prisma": ["./generated/prisma"],
      "@schemas/*": ["./src/schemas/*"]
    }
  },
  "include": ["src"]
}
